{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "python manage.py tailwind build && python manage.py collectstatic --noinput"
  },
  "deploy": {
    "startCommand": "gunicorn config.wsgi:application --bind 0.0.0.0:$PORT --workers 2 --access-logfile -",
    "healthcheckPath": "/salud/",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3,
    "preDeployCommand": [
      "python manage.py migrate --noinput",
      "python manage.py sembrar --contrasena-de-desarrollo \"$SEED_CONTRASENA_INSTITUCION\""
    ]
  }
}
