# Copiar a `.env` y ajustar. `.env` NUNCA se versiona.
#
#     cp .env.example .env
#
# **Con `docker compose up` no hace falta** (DT-37): las variables de la
# aplicación están en `compose.yaml`. Este fichero es para ejecutar Django en
# el host con `uv run` (`[S1.0.2]` de docs/desarrollo.md). El compose sí lee de
# aquí, si existen, los puertos y estas tres:
#
#     UID=1000                  # tu `id -u`, si no es el 1000
#     GID=1000                  # tu `id -g`
#     SEMBRAR_ESTUDIANTES=12    # y SEMBRAR_CONTRASENA= (vacía) para no sembrar
#
# Los valores de abajo son los de desarrollo local y sirven tal cual: las
# credenciales son ficticias y solo valen contra los contenedores de
# `compose.yaml`. En el entorno desplegado (TT-04) las inyecta el PaaS.

# --- Django ---------------------------------------------------------------
# En local sirve cualquier valor. En producción tiene que ser aleatorio y
# secreto; lo genera el PaaS.
DJANGO_SECRET_KEY=clave-solo-para-desarrollo-local-no-usar-fuera-de-aqui
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL (DT-1) ----------------------------------------------------
# Estas tres las lee el contenedor de `compose.yaml` para inicializar la base.
POSTGRES_DB=smartfood
POSTGRES_USER=smartfood
POSTGRES_PASSWORD=smartfood-local
POSTGRES_PORT=5432

# Esta la lee Django. Debe concordar con las de arriba. Un único DATABASE_URL
# porque es lo que entrega el PaaS en TT-04: mismo formato en local y desplegado.
DATABASE_URL=postgres://smartfood:smartfood-local@localhost:5432/smartfood

# --- Correo (TT-06) -------------------------------------------------------
# Una sola URL describe el envío entero, igual que DATABASE_URL describe la base.
#
#   consolemail://                        imprime el correo por la consola
#   smtp+tls://usuario:clave@host:587     envío real
#
# En local se deja en consola: nadie necesita credenciales para desarrollar y
# ningún correo sale de una máquina de desarrollo por accidente.
EMAIL_URL=consolemail://
DJANGO_DEFAULT_FROM_EMAIL=SmartFood <onboarding@resend.dev>
DJANGO_EMAIL_TIMEOUT=10

# --- Almacenamiento de objetos (DT-18, DT-38) -----------------------------
# SeaweedFS, compatible con S3, en el `compose.yaml`. Las credenciales de abajo
# las leen a la vez el servidor —que crea con ellas su única identidad— y
# Django. El puerto es el del API S3 en el host.
S3_PORT=9000

# UN bucket con dos prefijos, `privado/` y `publico/` (DT-21): la topología
# que el código espera, replicada en local para que el control de acceso se
# comporte igual que en cualquier otro sitio (DT-18).
S3_ENDPOINT_URL=http://localhost:9000
# La dirección con la que el NAVEGADOR llega al almacenamiento, para firmar las
# URL de las fotografías. Vacía, es la de arriba: solo difieren con la
# aplicación dentro del compose, que la define allí (DT-37).
S3_ENDPOINT_URL_PUBLICO=
S3_BUCKET=smartfood
S3_ACCESS_KEY_ID=smartfood
S3_SECRET_ACCESS_KEY=smartfood-local
S3_REGION=auto
# Estilo ruta: `localhost:9000/smartfood/…`, no `smartfood.localhost:9000/…`.
S3_ADDRESSING_STYLE=path
# Segundos que vive la URL firmada de una fotografía de estudiante.
S3_CADUCIDAD_FIRMA=300
