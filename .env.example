# Copiar a `.env` y ajustar. `.env` NUNCA se versiona.
#
#     cp .env.example .env
#
# Los valores de abajo son los de desarrollo local y sirven tal cual: las
# credenciales son ficticias y solo valen contra los contenedores de
# `compose.yaml`. En el entorno desplegado (TT-04) las inyecta el PaaS.

# --- Django ---------------------------------------------------------------
# En local sirve cualquier valor. En producción tiene que ser aleatorio y
# secreto; lo genera el PaaS.
DJANGO_SECRET_KEY=clave-solo-para-desarrollo-local-no-usar-fuera-de-aqui
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL (DT-1) ----------------------------------------------------
# Estas tres las lee el contenedor de `compose.yaml` para inicializar la base.
POSTGRES_DB=smartfood
POSTGRES_USER=smartfood
POSTGRES_PASSWORD=smartfood-local
POSTGRES_PORT=5432

# Esta la lee Django. Debe concordar con las de arriba. Un único DATABASE_URL
# porque es lo que entrega el PaaS en TT-04: mismo formato en local y desplegado.
DATABASE_URL=postgres://smartfood:smartfood-local@localhost:5432/smartfood

# --- MinIO (DT-18) --------------------------------------------------------
# Almacenamiento de objetos compatible con S3. Django todavía no lo usa: eso
# llega con TT-50 y TT-55, en PR-07. Aquí solo se levanta el servicio.
# Consola web: http://localhost:9001
MINIO_ROOT_USER=smartfood
MINIO_ROOT_PASSWORD=smartfood-local
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
